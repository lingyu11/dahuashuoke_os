megs : 32
romimage: file=/usr/local/bochs/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/local/bochs/share/bochs/VGABIOS-lgpl-latest
boot: disk
log: bochs.out
mouse:enabled=0
display_library: sdl2
keyboard: keymap=/usr/local/bochs/share/bochs/keymaps/sdl2-pc-us.map
ata0:enabled=1,ioaddr1=0x1f0,ioaddr2=0x3f0,irq=14
ata0-master: type=disk, path="hd10M.img", mode=flat,cylinders=20,heads=16,spt=63
ata0-slave:  type=disk, path="hd50M.img", mode=flat, cylinders=101, heads=16, spt=63

